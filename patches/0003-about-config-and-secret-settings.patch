From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IvyCZE <me@ivy.yt>
Date: Fri, 6 Nov 2026 16:34:24 +0000
Subject: [PATCH] Embermine: 0003-about-config-and-secret-settings

Enable about:config in every channel, and keep the five-tap About logo unlock of the secret settings across restarts by storing it in the persistent debug menu preference instead of a session-only field.

Co-authored-by: factory-droid[bot] <138933559+factory-droid[bot]@users.noreply.github.com>

diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/gecko/GeckoProvider.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/gecko/GeckoProvider.kt
index 1edcf54eebadbba11ac06b2d1a45ccc8e8b1504c..c1ccddf9a01118f5f1b4539fd85f1521908e55aa 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/gecko/GeckoProvider.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/gecko/GeckoProvider.kt
@@ -128,7 +128,7 @@ object GeckoProvider {
                 )
                 .consoleOutput(context.components.settings.enableGeckoLogs)
                 .debugLogging(Config.channel.isDebug || context.components.settings.enableGeckoLogs)
-                .aboutConfigEnabled(Config.channel.isBeta || Config.channel.isNightlyOrDebug)
+                .aboutConfigEnabled(true)
                 .extensionsProcessEnabled(true)
                 .extensionsWebAPIEnabled(true)
                 .translationsOfferPopup(context.components.settings.offerTranslation)
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/about/AboutFragment.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/about/AboutFragment.kt
index 1ffc02d2cb009b65ea96cf068875a3bfe6d6103d..8c15ca6c369190ce08f819765b1d27fd4557e80f 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/about/AboutFragment.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/about/AboutFragment.kt
@@ -137,7 +137,7 @@ class AboutFragment(private val toastHandler: ToastHandler = DefaultToastHandler
     /** Handles the activation of the debug menu. */
     @VisibleForTesting
     internal fun onDebugMenuActivated(context: Context, settings: Settings) {
-        settings.showSecretDebugMenuThisSession = true
+        settings.isDebugMenuPersistentlyRevealed = true
         toastHandler.showToast(
             context,
             context.getString(R.string.about_debug_menu_toast_done),
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt
index 8a5b0deadddcbce5d3ffb0c020957910f26d6758..00e5b4bb8b9e0b7b4e00dda7a29336a7c6fb0e23 100644
--- a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt
@@ -898,16 +898,14 @@ class Settings(
 
     var isOverrideTPPopupsForPerformanceTest = false
 
-    // We do not use `booleanPreference` because we only want the "read" part of this setting to be
-    // controlled by a shared pref (if any). In the secret settings, there is a toggle switch to enable
-    // and disable this pref. Other than that, the `SecretDebugMenuTrigger` should be able to change
-    // this setting for the duration of the session only, i.e. `SecretDebugMenuTrigger` should never
-    // be able to (indirectly) change the value of the shared pref.
     var showSecretDebugMenuThisSession: Boolean = false
         get() = field || isDebugMenuPersistentlyRevealed
 
-    /** Preference for determining whether the debug menu setting is revealed persistently */
-    val isDebugMenuPersistentlyRevealed: Boolean by
+    /**
+     * Preference for determining whether the debug menu setting is revealed persistently. The About logo
+     * unlock sets it, and the "Keep Debug Menu revealed" toggle in the secret settings can clear it.
+     */
+    var isDebugMenuPersistentlyRevealed: Boolean by
         booleanPreference(
             appContext.getPreferenceKey(R.string.pref_key_persistent_debug_menu),
             Config.channel.isDebug,
diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/about/AboutFragmentTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/about/AboutFragmentTest.kt
index acf9ad0029565558ee12c4ead3de864b7a69df9a..31bb18602281c8e4f745e4dc222c49943d939a44 100644
--- a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/about/AboutFragmentTest.kt
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/about/AboutFragmentTest.kt
@@ -46,7 +46,7 @@ class AboutFragmentTest {
 
         every { context.getString(R.string.about_debug_menu_toast_progress, 3) } returns message
         every { context.getString(R.string.about_debug_menu_toast_done) } returns doneMessage
-        every { settings.showSecretDebugMenuThisSession = true } just runs
+        every { settings.isDebugMenuPersistentlyRevealed = true } just runs
         every { lifecycle.addObserver(capture(secretDebugMenuTrigger)) } answers {}
     }
 
@@ -82,7 +82,7 @@ class AboutFragmentTest {
         fragment.onDebugMenuActivated(context, settings)
 
         verify { toastHandler.showToast(context, doneMessage, Toast.LENGTH_LONG) }
-        verify { settings.showSecretDebugMenuThisSession = true }
+        verify { settings.isDebugMenuPersistentlyRevealed = true }
     }
 
     @Test
