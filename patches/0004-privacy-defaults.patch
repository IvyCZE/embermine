diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/embermine/EmbermineMetricControllerTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/embermine/EmbermineMetricControllerTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..b89b5bf231ed41f5502937a5472b145d84815a58
--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/embermine/EmbermineMetricControllerTest.kt
@@ -0,0 +1,150 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import io.mockk.every
+import io.mockk.mockk
+import io.mockk.verify
+import org.junit.Test
+import org.mozilla.fenix.components.metrics.AdjustMetricsService
+import org.mozilla.fenix.components.metrics.Event
+import org.mozilla.fenix.components.metrics.FirstSessionMetricsService
+import org.mozilla.fenix.components.metrics.GleanMetricsService
+import org.mozilla.fenix.components.metrics.GleanUsageReportingMetricsService
+import org.mozilla.fenix.components.metrics.InstallReferrerMetricsService
+import org.mozilla.fenix.components.metrics.MetricServiceType
+
+class EmbermineMetricControllerTest {
+
+    private var dataEnabled = false
+    private var usageEnabled = false
+
+    private val gleanData = mockk<GleanMetricsService>(relaxed = true) {
+        every { type } returns MetricServiceType.Data
+        every { shouldTrack(any()) } returns true
+    }
+    private val gleanUsage = mockk<GleanUsageReportingMetricsService>(relaxed = true) {
+        every { type } returns MetricServiceType.UsageReporting
+        every { shouldTrack(any()) } returns true
+    }
+    private val adjust = mockk<AdjustMetricsService>(relaxed = true) {
+        every { type } returns MetricServiceType.Marketing
+        every { shouldTrack(any()) } returns true
+    }
+    private val installReferrer = mockk<InstallReferrerMetricsService>(relaxed = true) {
+        every { type } returns MetricServiceType.Data
+        every { shouldTrack(any()) } returns true
+    }
+    private val firstSession = mockk<FirstSessionMetricsService>(relaxed = true) {
+        every { type } returns MetricServiceType.Data
+        every { shouldTrack(any()) } returns true
+    }
+
+    private val event = Event.GrowthData.ConversionEvent6
+
+    private fun controller() = EmbermineMetricController(
+        services = listOf(adjust, installReferrer, firstSession, gleanData, gleanUsage),
+        isDataTelemetryEnabled = { dataEnabled },
+        isUsageTelemetryEnabled = { usageEnabled },
+    )
+
+    @Test
+    fun `default off starts no service and tracks no event`() {
+        val controller = controller()
+
+        controller.start(MetricServiceType.Data)
+        controller.start(MetricServiceType.UsageReporting)
+        controller.track(event)
+
+        verify(exactly = 0) { gleanData.start() }
+        verify(exactly = 0) { gleanUsage.start() }
+        verify(exactly = 0) { gleanData.track(any()) }
+        verify(exactly = 0) { gleanUsage.track(any()) }
+    }
+
+    @Test
+    fun `usage reporting opt-in starts the service and opt-out stops it`() {
+        val controller = controller()
+
+        usageEnabled = true
+        controller.start(MetricServiceType.UsageReporting)
+        controller.track(event)
+        verify(exactly = 1) { gleanUsage.start() }
+        verify(exactly = 1) { gleanUsage.track(event) }
+
+        usageEnabled = false
+        controller.stop(MetricServiceType.UsageReporting)
+        controller.track(event)
+        verify(exactly = 1) { gleanUsage.stop() }
+        verify(exactly = 1) { gleanUsage.track(any()) }
+    }
+
+    @Test
+    fun `usage reporting restarts when the opt-in is persisted`() {
+        usageEnabled = true
+
+        controller().start(MetricServiceType.UsageReporting)
+
+        verify(exactly = 1) { gleanUsage.start() }
+    }
+
+    @Test
+    fun `data opt-in starts glean metrics and opt-out stops them`() {
+        val controller = controller()
+
+        dataEnabled = true
+        controller.start(MetricServiceType.Data)
+        controller.track(event)
+        verify(exactly = 1) { gleanData.start() }
+        verify(exactly = 1) { gleanData.track(event) }
+
+        dataEnabled = false
+        controller.stop(MetricServiceType.Data)
+        controller.track(event)
+        verify(exactly = 1) { gleanData.stop() }
+        verify(exactly = 1) { gleanData.track(any()) }
+    }
+
+    @Test
+    fun `data restarts when the opt-in is persisted`() {
+        dataEnabled = true
+
+        controller().start(MetricServiceType.Data)
+
+        verify(exactly = 1) { gleanData.start() }
+    }
+
+    @Test
+    fun `repeated start while opted in starts the service once`() {
+        dataEnabled = true
+        val controller = controller()
+
+        controller.start(MetricServiceType.Data)
+        controller.start(MetricServiceType.Data)
+
+        verify(exactly = 1) { gleanData.start() }
+    }
+
+    @Test
+    fun `marketing and first session services never start even when opted in`() {
+        dataEnabled = true
+        usageEnabled = true
+        val controller = controller()
+
+        controller.start(MetricServiceType.Marketing)
+        controller.start(MetricServiceType.Data)
+        controller.track(event)
+        controller.stop(MetricServiceType.Marketing)
+
+        verify(exactly = 0) { adjust.start() }
+        verify(exactly = 0) { adjust.stop() }
+        verify(exactly = 0) { adjust.track(any()) }
+        verify(exactly = 0) { installReferrer.start() }
+        verify(exactly = 0) { installReferrer.track(any()) }
+        verify(exactly = 0) { firstSession.start() }
+        verify(exactly = 0) { firstSession.track(any()) }
+        verify(exactly = 1) { gleanData.start() }
+    }
+}
