+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import mozilla.components.concept.engine.EngineSession.SafeBrowsingPolicy
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class SafeBrowsingConfigTest {
+
+    @Test
+    fun `without a key safe browsing policy is none`() {
+        assertArrayEquals(arrayOf(SafeBrowsingPolicy.NONE), safeBrowsingPolicyFor(""))
+    }
+
+    @Test
+    fun `without a key no safe browsing provider is configured`() {
+        assertEquals(0, safeBrowsingProvidersFor("").size)
+    }
+
+    @Test
+    fun `with a key safe browsing policy is recommended`() {
+        assertArrayEquals(arrayOf(SafeBrowsingPolicy.RECOMMENDED), safeBrowsingPolicyFor("test-key"))
+    }
+
+    @Test
+    fun `with a key every google provider update url uses the key and no placeholder remains`() {
+        val providers = safeBrowsingProvidersFor("test-key")
+
+        assertEquals(listOf("google", "google4", "google5"), providers.map { it.name })
+        providers.forEach { provider ->
+            val updateUrl = provider.getUpdateUrl().orEmpty()
+            assertTrue(updateUrl, updateUrl.contains("key=test-key"))
+        }
+        providers.flatMap { listOfNotNull(it.getUpdateUrl(), it.getGetHashUrl(), it.getDataSharingUrl()) }
+            .forEach { url -> assertFalse(url, url.contains("%GOOGLE_SAFEBROWSING_API_KEY%")) }
+    }
+
+    @Test
+    fun `with a key the v5 provider stays enabled`() {
+        val v5Provider = safeBrowsingProvidersFor("test-key").single { it.name == "google5" }
+
+        assertEquals(true, v5Provider.enabled)
+    }
+}
