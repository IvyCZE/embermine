+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import mozilla.components.concept.engine.EngineSession.SafeBrowsingPolicy
+import org.mozilla.geckoview.ContentBlocking
+import org.mozilla.geckoview.ContentBlocking.SafeBrowsingProvider
+
+private const val GOOGLE_API_KEY_PLACEHOLDER = "%GOOGLE_SAFEBROWSING_API_KEY%"
+
+/**
+ * Returns the Safe Browsing policy for [apiKey]: the recommended categories when a key is set, none otherwise.
+ */
+internal fun safeBrowsingPolicyFor(apiKey: String): Array<SafeBrowsingPolicy> =
+    if (apiKey.isEmpty()) arrayOf(SafeBrowsingPolicy.NONE) else arrayOf(SafeBrowsingPolicy.RECOMMENDED)
+
+/**
+ * Returns the GeckoView Google Safe Browsing providers with [apiKey] in their URLs. Without a key no provider is
+ * configured, so GeckoView never uses the key Mozilla embeds in its build.
+ */
+internal fun safeBrowsingProvidersFor(apiKey: String): Array<SafeBrowsingProvider> =
+    if (apiKey.isEmpty()) {
+        emptyArray()
+    } else {
+        arrayOf(
+            ContentBlocking.GOOGLE_LEGACY_SAFE_BROWSING_PROVIDER,
+            ContentBlocking.GOOGLE_SAFE_BROWSING_PROVIDER,
+            ContentBlocking.GOOGLE_SAFE_BROWSING_V5_PROVIDER,
+        ).map { it.withApiKey(apiKey) }.toTypedArray()
+    }
+
+private fun SafeBrowsingProvider.withApiKey(apiKey: String): SafeBrowsingProvider {
+    val builder = SafeBrowsingProvider.from(this)
+    getUpdateUrl()?.let { builder.updateUrl(it.replace(GOOGLE_API_KEY_PLACEHOLDER, apiKey)) }
+    getGetHashUrl()?.let { builder.getHashUrl(it.replace(GOOGLE_API_KEY_PLACEHOLDER, apiKey)) }
+    getDataSharingUrl()?.let { builder.dataSharingUrl(it.replace(GOOGLE_API_KEY_PLACEHOLDER, apiKey)) }
+    return builder.build()
+}
