@@ -0,0 +1,64 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import org.mozilla.fenix.components.metrics.Event
+import org.mozilla.fenix.components.metrics.GleanMetricsService
+import org.mozilla.fenix.components.metrics.GleanUsageReportingMetricsService
+import org.mozilla.fenix.components.metrics.MetricController
+import org.mozilla.fenix.components.metrics.MetricServiceType
+import org.mozilla.fenix.components.metrics.MetricsService
+
+/**
+ * Metric controller for builds with release telemetry off. It never registers a Facts processor and
+ * never starts the marketing or first-session services. The Glean services run only while the user
+ * has opted in.
+ */
+class EmbermineMetricController(
+    private val services: List<MetricsService>,
+    private val isDataTelemetryEnabled: () -> Boolean,
+    private val isUsageTelemetryEnabled: () -> Boolean,
+) : MetricController {
+    private val initialized = mutableSetOf<MetricServiceType>()
+
+    override fun start(type: MetricServiceType) {
+        if (!isEnabled(type) || type in initialized) return
+
+        permittedServices(type).forEach { it.start() }
+
+        initialized.add(type)
+    }
+
+    override fun stop(type: MetricServiceType) {
+        if (isEnabled(type) || type !in initialized) return
+
+        permittedServices(type).forEach { it.stop() }
+
+        initialized.remove(type)
+    }
+
+    override fun track(event: Event) {
+        services
+            .filter { isPermitted(it) && it.shouldTrack(event) }
+            .forEach {
+                if (!isEnabled(it.type) || it.type !in initialized) return@forEach
+
+                it.track(event)
+            }
+    }
+
+    private fun permittedServices(type: MetricServiceType): List<MetricsService> =
+        services.filter { it.type == type && isPermitted(it) }
+
+    private fun isPermitted(service: MetricsService): Boolean =
+        service is GleanMetricsService || service is GleanUsageReportingMetricsService
+
+    private fun isEnabled(type: MetricServiceType): Boolean =
+        when (type) {
+            MetricServiceType.Data -> isDataTelemetryEnabled()
+            MetricServiceType.UsageReporting -> isUsageTelemetryEnabled()
+            MetricServiceType.Marketing -> false
+        }
+}
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/GeckoPrivacyPrefs.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/GeckoPrivacyPrefs.kt
