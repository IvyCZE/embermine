+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import android.os.Handler
+import android.os.Looper
+import org.mozilla.geckoview.GeckoPreferenceController
+import org.mozilla.geckoview.GeckoPreferenceController.PREF_BRANCH_DEFAULT
+import org.mozilla.geckoview.GeckoPreferenceController.SetGeckoPreference
+
+internal fun embermineGeckoPrivacyPrefs(): List<SetGeckoPreference<*>> =
+    listOf(
+        SetGeckoPreference.setBoolPref("datareporting.healthreport.uploadEnabled", false, PREF_BRANCH_DEFAULT),
+        SetGeckoPreference.setBoolPref("datareporting.policy.dataSubmissionEnabled", false, PREF_BRANCH_DEFAULT),
+        SetGeckoPreference.setStringPref("browser.region.network.url", "", PREF_BRANCH_DEFAULT),
+    )
+
+/**
+ * Sets the Gecko default prefs that keep Gecko telemetry upload and the region lookup off. Embermine ships Mozilla's
+ * prebuilt GeckoView, so these defaults are set at runtime rather than in the bundled default pref file.
+ */
+fun applyEmbermineGeckoPrivacyPrefs() {
+    Handler(Looper.getMainLooper()).post {
+        GeckoPreferenceController.setGeckoPrefs(embermineGeckoPrivacyPrefs())
+    }
+}
