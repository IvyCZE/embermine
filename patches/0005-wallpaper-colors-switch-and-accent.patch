@@ -0,0 +1,29 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class EmbermineViewAccentTest {
+
+    @Test
+    fun `view accent is off below Android 12`() {
+        assertFalse(EmbermineAccent.isViewAccentEnabled(sdkInt = 30, switchOn = true, isPrivate = false))
+    }
+
+    @Test
+    fun `view accent follows the switch on Android 12 and newer`() {
+        assertTrue(EmbermineAccent.isViewAccentEnabled(sdkInt = 31, switchOn = true, isPrivate = false))
+        assertFalse(EmbermineAccent.isViewAccentEnabled(sdkInt = 31, switchOn = false, isPrivate = false))
+        assertTrue(EmbermineAccent.isViewAccentEnabled(sdkInt = 34, switchOn = true, isPrivate = false))
+    }
+
+    @Test
+    fun `private mode keeps the Firefox accent`() {
+        assertFalse(EmbermineAccent.isViewAccentEnabled(sdkInt = 34, switchOn = true, isPrivate = true))
+    }
+}
