+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import androidx.compose.material3.ColorScheme
+import mozilla.components.compose.base.theme.AcornGradient
+import mozilla.components.compose.base.theme.AcornGradientScheme
+import mozilla.components.compose.base.utils.ColorStop
+
+/**
+ * Maps a Material You scheme onto Firefox's accent slots. Surfaces, backgrounds, neutrals and error
+ * colors are never copied, so only the accents follow the wallpaper.
+ */
+object EmbermineAccentScheme {
+
+    fun colorScheme(base: ColorScheme, dynamic: ColorScheme): ColorScheme = base.copy(
+        primary = dynamic.primary,
+        onPrimary = dynamic.onPrimary,
+        primaryContainer = dynamic.primaryContainer,
+        onPrimaryContainer = dynamic.onPrimaryContainer,
+        inversePrimary = dynamic.inversePrimary,
+        secondaryContainer = dynamic.secondaryContainer,
+        onSecondaryContainer = dynamic.onSecondaryContainer,
+        tertiary = dynamic.primary,
+        onTertiary = dynamic.onPrimary,
+        tertiaryContainer = dynamic.primaryContainer,
+        onTertiaryContainer = dynamic.onPrimaryContainer,
+    )
+
+    fun gradients(base: AcornGradientScheme, dynamic: ColorScheme): AcornGradientScheme = base.copy(
+        cfr = twoTone(base.cfr, dynamic),
+        accent = twoTone(base.accent, dynamic),
+        tabOutline = twoTone(base.tabOutline, dynamic),
+    )
+
+    private fun twoTone(gradient: AcornGradient, dynamic: ColorScheme): AcornGradient = gradient.copy(
+        colorStops = gradient.colorStops.mapIndexed { index, stop ->
+            ColorStop(stop.position, if (index == 0) dynamic.primary else dynamic.tertiary)
+        },
+    )
+}
