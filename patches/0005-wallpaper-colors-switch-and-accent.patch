+
+package org.mozilla.fenix.embermine
+
+import android.content.Context
+import android.os.Build
+import androidx.compose.material3.ColorScheme
+import androidx.compose.material3.dynamicDarkColorScheme
+import androidx.compose.material3.dynamicLightColorScheme
+import mozilla.components.compose.base.theme.AcornGradientScheme
+import mozilla.components.compose.base.theme.Theme
+import org.mozilla.fenix.ext.components
+
+/**
+ * Applies the wallpaper accent colors when "Use wallpaper colors" is on. Private mode and Android
+ * versions below 12 keep the Firefox colors.
+ */
+object EmbermineAccent {
+
+    fun colorScheme(context: Context, theme: Theme, base: ColorScheme): ColorScheme {
+        val dynamic = dynamicScheme(context, theme) ?: return base
+        return EmbermineAccentScheme.colorScheme(base, dynamic)
+    }
+
+    fun gradients(context: Context, theme: Theme, base: AcornGradientScheme): AcornGradientScheme {
+        val dynamic = dynamicScheme(context, theme) ?: return base
+        return EmbermineAccentScheme.gradients(base, dynamic)
+    }
+
+    private fun dynamicScheme(context: Context, theme: Theme): ColorScheme? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return null
+        if (theme == Theme.Private || !context.components.settings.isEmbermineWallpaperColorsEnabled) return null
+        return when (theme) {
+            Theme.Light -> dynamicLightColorScheme(context)
+            Theme.Dark, Theme.Oled -> dynamicDarkColorScheme(context)
+            Theme.Private -> null
+        }
+    }
+}
