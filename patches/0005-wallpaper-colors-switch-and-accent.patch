diff --git a/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/embermine/EmbermineAccentSchemeTest.kt b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/embermine/EmbermineAccentSchemeTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..4ca459223d9735877d58ac10565b7d2a583a9725
--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/embermine/EmbermineAccentSchemeTest.kt
@@ -0,0 +1,129 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import androidx.compose.material3.lightColorScheme
+import androidx.compose.ui.graphics.Color
+import mozilla.components.compose.base.theme.AcornGradient
+import mozilla.components.compose.base.theme.AcornGradientScheme
+import mozilla.components.compose.base.theme.AcornGradientType
+import mozilla.components.compose.base.utils.ColorStop
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class EmbermineAccentSchemeTest {
+
+    private val firefoxScheme = lightColorScheme(
+        primary = Color(0xFF3E2976),
+        onPrimary = Color(0xFFFFFFFF),
+        primaryContainer = Color(0xFFCDB7FF),
+        onPrimaryContainer = Color(0xFF180E30),
+        inversePrimary = Color(0xFFCDB7FF),
+        secondary = Color(0xFF6B6B6B),
+        secondaryContainer = Color(0xFFE2DCF2),
+        onSecondaryContainer = Color(0xFF180E30),
+        tertiary = Color(0xFF764EDD),
+        onTertiary = Color(0xFFFFFFFF),
+        tertiaryContainer = Color(0xFFF5ECFF),
+        onTertiaryContainer = Color(0xFF180E30),
+        background = Color(0xFFF2F0F8),
+        surface = Color(0xFFFBFAFE),
+        error = Color(0xFFB3261E),
+        outline = Color(0xFF8A8A8A),
+    )
+
+    private val dynamicScheme = lightColorScheme(
+        primary = Color(0xFF2E7D32),
+        onPrimary = Color(0xFFFFFFFF),
+        primaryContainer = Color(0xFFB8F0B4),
+        onPrimaryContainer = Color(0xFF002204),
+        inversePrimary = Color(0xFF9CD69A),
+        secondaryContainer = Color(0xFFD2E8CF),
+        onSecondaryContainer = Color(0xFF0E2110),
+        tertiary = Color(0xFF3A6A6A),
+        onTertiary = Color(0xFFFFFFFF),
+        tertiaryContainer = Color(0xFFBDEFEF),
+        onTertiaryContainer = Color(0xFF002020),
+        background = Color(0xFF112211),
+        surface = Color(0xFF112211),
+        error = Color(0xFF00FF00),
+        outline = Color(0xFF00FF00),
+    )
+
+    private val firefoxGradients = AcornGradientScheme(
+        cfr = linear(Color(0xFF5939A8), Color(0xFF764EDD)),
+        accent = linear(Color(0xFFB393FF), Color(0xFFFFB27A)),
+        accentSubtle = linear(Color(0xFFE5D6FF), Color(0xFFFFE0C2)),
+        tabOutline = linear(Color(0xFFB393FF), Color(0xFF764EDD)),
+        privacyMask = AcornGradient(
+            type = AcornGradientType.Vertical,
+            colorStops = listOf(ColorStop(0f, Color(0xFFCDB7FF)), ColorStop(1f, Color(0xFFFFFFFF))),
+        ),
+    )
+
+    @Test
+    fun `accent slots take the dynamic primary family`() {
+        val result = EmbermineAccentScheme.colorScheme(firefoxScheme, dynamicScheme)
+
+        assertEquals(dynamicScheme.primary, result.primary)
+        assertEquals(dynamicScheme.onPrimary, result.onPrimary)
+        assertEquals(dynamicScheme.primaryContainer, result.primaryContainer)
+        assertEquals(dynamicScheme.onPrimaryContainer, result.onPrimaryContainer)
+        assertEquals(dynamicScheme.inversePrimary, result.inversePrimary)
+        assertEquals(dynamicScheme.secondaryContainer, result.secondaryContainer)
+        assertEquals(dynamicScheme.onSecondaryContainer, result.onSecondaryContainer)
+    }
+
+    @Test
+    fun `tertiary accents follow the dynamic primary instead of the dynamic tertiary`() {
+        val result = EmbermineAccentScheme.colorScheme(firefoxScheme, dynamicScheme)
+
+        assertEquals(dynamicScheme.primary, result.tertiary)
+        assertEquals(dynamicScheme.onPrimary, result.onTertiary)
+        assertEquals(dynamicScheme.primaryContainer, result.tertiaryContainer)
+        assertEquals(dynamicScheme.onPrimaryContainer, result.onTertiaryContainer)
+    }
+
+    @Test
+    fun `surfaces backgrounds neutrals and error keep the Firefox colors`() {
+        val result = EmbermineAccentScheme.colorScheme(firefoxScheme, dynamicScheme)
+
+        assertEquals(firefoxScheme.background, result.background)
+        assertEquals(firefoxScheme.surface, result.surface)
+        assertEquals(firefoxScheme.secondary, result.secondary)
+        assertEquals(firefoxScheme.error, result.error)
+        assertEquals(firefoxScheme.outline, result.outline)
+    }
+
+    @Test
+    fun `accent gradients run from the dynamic primary to the dynamic tertiary`() {
+        val result = EmbermineAccentScheme.gradients(firefoxGradients, dynamicScheme)
+
+        listOf(result.tabOutline, result.accent, result.cfr).forEach { gradient ->
+            assertEquals(2, gradient.colorStops.size)
+            assertEquals(dynamicScheme.primary, gradient.colorStops.first().color)
+            assertEquals(dynamicScheme.tertiary, gradient.colorStops.last().color)
+        }
+        assertEquals(
+            firefoxGradients.tabOutline.colorStops.map { it.position },
+            result.tabOutline.colorStops.map { it.position },
+        )
+        assertEquals(firefoxGradients.accent.type, result.accent.type)
+        assertEquals(firefoxGradients.cfr.type, result.cfr.type)
+    }
+
+    @Test
+    fun `gradients outside the accent set keep the Firefox values`() {
+        val result = EmbermineAccentScheme.gradients(firefoxGradients, dynamicScheme)
+
+        assertEquals(firefoxGradients.accentSubtle, result.accentSubtle)
+        assertEquals(firefoxGradients.privacyMask, result.privacyMask)
+    }
+
+    private fun linear(start: Color, end: Color) = AcornGradient(
+        type = AcornGradientType.Linear(angleInDegrees = 96f),
+        colorStops = listOf(ColorStop(0f, start), ColorStop(0.71f, end)),
+    )
+}
