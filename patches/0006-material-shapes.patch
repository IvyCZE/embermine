+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package mozilla.components.compose.base.embermine
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawBehind
+import androidx.compose.ui.geometry.Size
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.drawOutline
+import androidx.compose.ui.graphics.drawscope.translate
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+
+private val SHAPE_CONTAINER_SIZE: Dp = 40.dp
+private const val DISABLED_ALPHA = 0.38f
+
+/**
+ * Draws [shape] as a container behind [content] without changing the layout size of [content].
+ *
+ * @param shape The [EmbermineShape] of the container. When `null`, no container is drawn.
+ * @param defaultContentColor The content color used when [shape] is `null`.
+ * @param modifier [Modifier] to be applied to the layout.
+ * @param enabled Whether the container and its content are drawn in their enabled colors.
+ * @param containerSize The side length of the container, which is centered behind [content].
+ * @param content The content, receiving the color it should be tinted with.
+ */
+@Composable
+fun ShapedIconBackground(
+    shape: EmbermineShape?,
+    defaultContentColor: Color,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    containerSize: Dp = SHAPE_CONTAINER_SIZE,
+    content: @Composable (contentColor: Color) -> Unit,
+) {
+    if (shape == null) {
+        content(defaultContentColor)
+        return
+    }
+
+    val alpha = if (enabled) 1f else DISABLED_ALPHA
+    val containerColor = MaterialTheme.colorScheme.primaryContainer.copy(alpha = alpha)
+    val contentColor = MaterialTheme.colorScheme.onPrimaryContainer.copy(alpha = alpha)
+    val containerShape = shape.toShape()
+
+    Box(
+        modifier = modifier.drawBehind {
+            val containerSizePx = containerSize.toPx()
+            val outline = containerShape.createOutline(Size(containerSizePx, containerSizePx), layoutDirection, this)
+            translate(left = (size.width - containerSizePx) / 2f, top = (size.height - containerSizePx) / 2f) {
+                drawOutline(outline, containerColor)
+            }
+        },
+        contentAlignment = Alignment.Center,
+    ) {
+        content(contentColor)
+    }
+}
