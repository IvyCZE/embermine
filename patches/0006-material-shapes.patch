+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package mozilla.components.compose.base.embermine
+
+import androidx.compose.material3.ExperimentalMaterial3ExpressiveApi
+import androidx.compose.material3.MaterialShapes
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Test
+
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+class EmbermineShapeTest {
+
+    @Test
+    fun `every EmbermineShape maps to its MaterialShapes polygon`() {
+        val expected = mapOf(
+            EmbermineShape.Cookie12Sided to MaterialShapes.Cookie12Sided,
+            EmbermineShape.Cookie9Sided to MaterialShapes.Cookie9Sided,
+            EmbermineShape.Cookie7Sided to MaterialShapes.Cookie7Sided,
+            EmbermineShape.Cookie6Sided to MaterialShapes.Cookie6Sided,
+            EmbermineShape.Cookie4Sided to MaterialShapes.Cookie4Sided,
+            EmbermineShape.Sunny to MaterialShapes.Sunny,
+            EmbermineShape.Slanted to MaterialShapes.Slanted,
+            EmbermineShape.Flower to MaterialShapes.Flower,
+            EmbermineShape.Pentagon to MaterialShapes.Pentagon,
+            EmbermineShape.Clover4Leaf to MaterialShapes.Clover4Leaf,
+            EmbermineShape.Pill to MaterialShapes.Pill,
+            EmbermineShape.Gem to MaterialShapes.Gem,
+        )
+
+        assertEquals(EmbermineShape.entries.toSet(), expected.keys)
+        expected.forEach { (shape, polygon) ->
+            assertSame(polygon, shape.polygon)
+        }
+    }
+}
