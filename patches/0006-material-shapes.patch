+            R.id.httpsOnlyFragment,
+            R.id.crashListFragment,
+            R.id.settingsFragment,
+        )
+
+    @Test
+    fun `every Settings destination is a Settings screen without a preference fragment`() {
+        settingsDestinationIds.forEach { id ->
+            assertTrue(isSettingsScreen(isPreferenceFragment = false, destinationId = id, parentGraphId = null))
+        }
+    }
+
+    @Test
+    fun `a destination inside a Settings graph is a Settings screen`() {
+        assertTrue(
+            isSettingsScreen(
+                isPreferenceFragment = false,
+                destinationId = R.id.searchEngineFragment,
+                parentGraphId = R.id.search_engine_graph,
+            ),
+        )
+        assertTrue(
+            isSettingsScreen(
+                isPreferenceFragment = false,
+                destinationId = R.id.homeFragment,
+                parentGraphId = R.id.search_engine_graph,
+            ),
+        )
+    }
+
+    @Test
+    fun `a preference fragment is a Settings screen even without a known destination`() {
+        assertTrue(settingsScreen(destinationId = null, isPreferenceFragment = true))
+        assertTrue(settingsScreen(destinationId = R.id.homeFragment, isPreferenceFragment = true))
+    }
+
+    @Test
+    fun `other destinations are not Settings screens`() {
+        assertFalse(settingsScreen(destinationId = null))
+        assertFalse(settingsScreen(destinationId = R.id.homeFragment))
+        assertFalse(settingsScreen(destinationId = R.id.browserFragment, parentGraphId = R.id.nav_graph))
+        assertFalse(settingsScreen(destinationId = null, parentGraphId = R.id.nav_graph))
+    }
+
+    private fun settingsScreen(
+        destinationId: Int?,
+        parentGraphId: Int? = null,
+        isPreferenceFragment: Boolean = false,
+    ) = isSettingsScreen(
+        isPreferenceFragment = isPreferenceFragment,
+        destinationId = destinationId,
+        parentGraphId = parentGraphId,
+    )
+}
