+import mozilla.components.support.ktx.android.content.getColorFromAttr
+import org.mozilla.fenix.R
+import kotlin.math.roundToInt
+
+private const val SHAPE_CONTAINER_SIZE_DP = 40f
+
+internal fun Context.embermineShapedIcon(icon: Drawable, shape: EmbermineShape): Drawable {
+    val containerSizePx =
+        TypedValue.applyDimension(
+            TypedValue.COMPLEX_UNIT_DIP,
+            SHAPE_CONTAINER_SIZE_DP,
+            resources.displayMetrics,
+        ).roundToInt()
+    val iconColor = getColorFromAttr(materialR.attr.colorOnPrimaryContainer)
+    return EmbermineShapedIconDrawable(
+        shape = shape,
+        containerColor = getColorFromAttr(materialR.attr.colorPrimaryContainer),
+        icon = icon.mutate().apply { setTint(iconColor) },
+        containerSizePx = containerSizePx,
+    )
+}
+
+internal fun MenuItem.setEmbermineShapedIcon(context: Context, shape: EmbermineShape) {
+    val currentIcon = icon ?: return
+    setIcon(context.embermineShapedIcon(currentIcon, shape))
+    iconTintList = ColorStateList.valueOf(context.getColorFromAttr(materialR.attr.colorOnPrimaryContainer))
+}
+
+/**
+ * The shape of the back arrow for a Settings screen, or `null` for every other screen. Release builds obfuscate
+ * fragment class names, so the Settings section is detected through the back stack.
+ */
+internal fun Fragment.settingsBackNavigationShape(): EmbermineShape? =
+    EmbermineShape.Cookie12Sided.takeIf { isInSettingsBackStack() }
+
+private fun Fragment.isInSettingsBackStack(): Boolean =
+    runCatching { findNavController().getBackStackEntry(R.id.settingsFragment) }.isSuccess
