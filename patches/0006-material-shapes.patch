+internal fun Context.embermineShapedIcon(icon: Drawable, shape: EmbermineShape): Drawable {
+    val iconColor = getColorFromAttr(materialR.attr.colorOnPrimaryContainer)
+    return EmbermineShapedIconDrawable(
+        shape = shape,
+        containerColor = getColorFromAttr(materialR.attr.colorPrimaryContainer),
+        icon = icon.mutate().apply { setTint(iconColor) },
+        containerSizePx = dpToPx(SHAPE_CONTAINER_SIZE_DP),
+    )
+}
+
+/**
+ * Shows the shaped icon as a 48 dp action view. Action menu items clamp plain icons to 32 dp, so the 40 dp container
+ * is drawn inside the action view instead. [onClick] runs when the action view is tapped.
+ */
+internal fun MenuItem.setEmbermineShapedIcon(
+    context: Context,
+    shape: EmbermineShape,
+    onClick: (() -> Unit)? = null,
+) {
+    val currentIcon = icon ?: return
+    val shapedIcon = context.embermineShapedIcon(currentIcon, shape)
+    val label = title?.takeIf { it.isNotEmpty() } ?: contentDescription
+    setIcon(shapedIcon)
+    iconTintList = ColorStateList.valueOf(context.getColorFromAttr(materialR.attr.colorOnPrimaryContainer))
+    actionView =
+        AppCompatImageButton(context).apply {
+            layoutParams =
+                ViewGroup.LayoutParams(
+                    context.dpToPx(SHAPE_ACTION_SIZE_DP),
+                    context.dpToPx(SHAPE_ACTION_SIZE_DP),
+                )
+            scaleType = ImageView.ScaleType.CENTER
+            setBackgroundResource(context.borderlessSelectableBackground())
+            contentDescription = label
+            setImageDrawable(shapedIcon)
+            setOnClickListener { onClick?.invoke() }
+        }
+}
+
+/**
+ * The shape of the back arrow for a Settings screen, or `null` for every other screen. Release builds obfuscate
+ * fragment class names, so Settings screens are detected through the back stack, the current navigation destination
+ * and its graph, or the [PreferenceFragmentCompat] base class.
+ */
+internal fun Fragment.settingsBackNavigationShape(): EmbermineShape? =
+    if (this is PreferenceFragmentCompat) {
+        EmbermineShape.Cookie12Sided
+    } else {
+        runCatching { findNavController() }.getOrNull()?.let { settingsBackNavigationShape(it) }
+    }
+
+internal fun settingsBackNavigationShape(
+    navController: NavController,
+    destination: NavDestination? = navController.currentDestination,
+): EmbermineShape? =
+    EmbermineShape.Cookie12Sided.takeIf {
+        runCatching { navController.getBackStackEntry(R.id.settingsFragment) }.isSuccess ||
+            isSettingsScreen(
+                isPreferenceFragment = false,
+                destinationId = destination?.id,
+                parentGraphId = destination?.parent?.id,
+            )
+    }
+
+internal fun isSettingsScreen(
+    isPreferenceFragment: Boolean,
+    destinationId: Int?,
+    parentGraphId: Int?,
+): Boolean =
+    isPreferenceFragment || listOfNotNull(destinationId, parentGraphId).any { it in settingsDestinationIds }
+
+private fun Context.dpToPx(dp: Float): Int =
+    TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, dp, resources.displayMetrics).roundToInt()
+
+private fun Context.borderlessSelectableBackground(): Int {
+    val typedValue = TypedValue()
+    theme.resolveAttribute(android.R.attr.selectableItemBackgroundBorderless, typedValue, true)
+    return typedValue.resourceId
+}
