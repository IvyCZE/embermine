+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package mozilla.components.compose.base.embermine
+
+import android.content.res.ColorStateList
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.PixelFormat
+import android.graphics.PorterDuff
+import android.graphics.Rect
+import android.graphics.drawable.Drawable
+import androidx.annotation.ColorInt
+
+/**
+ * A [Drawable] that draws [icon] centered on an [EmbermineShape] container, for View toolbars and menus.
+ *
+ * Tints and color filters apply to [icon] only, so the container keeps its [containerColor].
+ *
+ * @param shape The [EmbermineShape] of the container.
+ * @param containerColor The fill color of the container.
+ * @param icon The icon drawn on top of the container, at its intrinsic size.
+ * @param containerSizePx The intrinsic width and height of this drawable in pixels.
+ */
+class EmbermineShapedIconDrawable(
+    shape: EmbermineShape,
+    @ColorInt containerColor: Int,
+    private val icon: Drawable,
+    private val containerSizePx: Int,
+) : Drawable() {
+    private val container = EmbermineShapeDrawable(shape, containerColor)
+
+    override fun onBoundsChange(bounds: Rect) {
+        super.onBoundsChange(bounds)
+        container.setBounds(bounds)
+        val left = bounds.centerX() - icon.intrinsicWidth / 2
+        val top = bounds.centerY() - icon.intrinsicHeight / 2
+        icon.setBounds(left, top, left + icon.intrinsicWidth, top + icon.intrinsicHeight)
+    }
+
+    override fun draw(canvas: Canvas) {
+        container.draw(canvas)
+        icon.draw(canvas)
+    }
+
+    override fun getIntrinsicWidth(): Int = containerSizePx
+
+    override fun getIntrinsicHeight(): Int = containerSizePx
+
+    override fun setAlpha(alpha: Int) {
+        container.setAlpha(alpha)
+        icon.setAlpha(alpha)
+    }
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {
+        icon.setColorFilter(colorFilter)
+    }
+
+    override fun setTint(tintColor: Int) {
+        icon.setTint(tintColor)
+    }
+
+    override fun setTintList(tint: ColorStateList?) {
+        icon.setTintList(tint)
+    }
+
+    override fun setTintMode(tintMode: PorterDuff.Mode?) {
+        icon.setTintMode(tintMode)
+    }
+
+    override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
