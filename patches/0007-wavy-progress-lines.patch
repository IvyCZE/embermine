+package mozilla.components.compose.base.embermine
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class EmberminePageProgressTest {
+
+    @Test
+    fun `page-load wave is shown only between 0 and 100 percent`() {
+        assertFalse(isEmberminePageProgressVisible(0))
+        assertTrue(isEmberminePageProgressVisible(1))
+        assertTrue(isEmberminePageProgressVisible(99))
+        assertFalse(isEmberminePageProgressVisible(100))
+    }
+}
