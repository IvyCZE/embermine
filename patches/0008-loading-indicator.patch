+package org.mozilla.fenix.embermine
+
+import android.content.Context
+import android.util.AttributeSet
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.ComposeView
+import mozilla.components.compose.base.embermine.EmbermineLoadingIndicator
+import org.mozilla.fenix.theme.FirefoxTheme
+
+class EmbermineLoadingIndicatorView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+) : FrameLayout(context, attrs) {
+
+    private var showContent by mutableStateOf(visibility == View.VISIBLE)
+
+    init {
+        addView(
+            ComposeView(context).apply {
+                setContent {
+                    FirefoxTheme {
+                        if (showContent) {
+                            EmbermineLoadingIndicator()
+                        }
+                    }
+                }
+            },
+            FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.WRAP_CONTENT,
+                FrameLayout.LayoutParams.WRAP_CONTENT,
+                Gravity.CENTER,
+            ),
+        )
+    }
+
+    override fun setVisibility(visibility: Int) {
+        super.setVisibility(visibility)
+        showContent = visibility == View.VISIBLE
+    }
+}
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/EmbermineRefreshIndicator.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/EmbermineRefreshIndicator.kt
new file mode 100644
index 0000000000000000000000000000000000000000..ff4e1d662aea1898aa565ba976b33e6e859f3018
--- /dev/null
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/EmbermineRefreshIndicator.kt
@@ -0,0 +1,90 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import android.graphics.Color
+import android.view.ViewGroup
+import android.widget.ImageView
+import androidx.compose.material3.ContainedLoadingIndicator
+import androidx.compose.material3.ExperimentalMaterial3ExpressiveApi
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableFloatStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.ComposeView
+import androidx.core.view.children
+import androidx.core.view.isVisible
+import androidx.swiperefreshlayout.widget.SwipeRefreshLayout
+import org.mozilla.fenix.theme.FirefoxTheme
+
+private class RefreshIndicatorState {
+    var refreshing by mutableStateOf(false)
+    var progress by mutableFloatStateOf(0f)
+}
+
+/**
+ * Hides the circle of this [SwipeRefreshLayout] and draws a contained morphing indicator in its place.
+ * The gesture handling is unchanged: the indicator mirrors the circle's position, scale, alpha and visibility.
+ */
+fun SwipeRefreshLayout.installEmbermineRefreshIndicator() {
+    val parentGroup = parent as? ViewGroup ?: return
+    val circle = children.filterIsInstance<ImageView>().firstOrNull() ?: return
+    circle.setImageDrawable(null)
+    circle.setBackgroundColor(Color.TRANSPARENT)
+    circle.elevation = 0f
+
+    val state = RefreshIndicatorState()
+    val overlay = ComposeView(context).apply {
+        setContent {
+            FirefoxTheme {
+                EmbermineRefreshIndicator(refreshing = state.refreshing, progress = { state.progress })
+            }
+        }
+    }
+    parentGroup.addView(
+        overlay,
+        parentGroup.indexOfChild(this) + 1,
+        ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT),
+    )
+
+    viewTreeObserver.addOnPreDrawListener {
+        state.refreshing = isRefreshing
+        state.progress = embermineRefreshProgress(circle.top, progressViewStartOffset, progressViewEndOffset)
+        overlay.isVisible = circle.isVisible
+        overlay.x = x + circle.x + (circle.width - overlay.width) / 2f
+        overlay.y = y + circle.y + (circle.height - overlay.height) / 2f
+        overlay.scaleX = circle.scaleX
+        overlay.scaleY = circle.scaleY
+        overlay.alpha = circle.alpha
+        true
+    }
+}
+
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+@Composable
+private fun EmbermineRefreshIndicator(refreshing: Boolean, progress: () -> Float) {
+    val containerColor = MaterialTheme.colorScheme.primaryContainer
+    val indicatorColor = MaterialTheme.colorScheme.onPrimaryContainer
+    if (refreshing) {
+        ContainedLoadingIndicator(containerColor = containerColor, indicatorColor = indicatorColor)
+    } else {
+        ContainedLoadingIndicator(
+            progress = progress,
+            containerColor = containerColor,
+            indicatorColor = indicatorColor,
+        )
+    }
+}
+
+/**
+ * Pull fraction in 0..1. [SwipeRefreshLayout] moves the circle from [startTop] by the drag fraction times the
+ * trigger distance, so [triggerDistance] is the refresh position's offset from the layout's top.
+ */
+internal fun embermineRefreshProgress(top: Int, startTop: Int, triggerDistance: Int): Float {
+    if (triggerDistance <= 0) return 0f
+    return ((top - startTop).toFloat() / triggerDistance).coerceIn(0f, 1f)
