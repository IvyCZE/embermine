--- /dev/null
+++ b/mobile/android/fenix/app/src/test/java/org/mozilla/fenix/embermine/EmbermineRefreshIndicatorTest.kt
@@ -0,0 +1,33 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class EmbermineRefreshIndicatorTest {
+
+    @Test
+    fun `progress is zero while the circle is at rest`() {
+        assertEquals(0f, embermineRefreshProgress(top = -105, startTop = -105, triggerDistance = 168), 0f)
+    }
+
+    @Test
+    fun `progress follows the circle to the refresh trigger`() {
+        assertEquals(0.5f, embermineRefreshProgress(top = -21, startTop = -105, triggerDistance = 168), 0.001f)
+        assertEquals(1f, embermineRefreshProgress(top = 63, startTop = -105, triggerDistance = 168), 0.001f)
+    }
+
+    @Test
+    fun `progress is clamped beyond the trigger and before rest`() {
+        assertEquals(1f, embermineRefreshProgress(top = 200, startTop = -105, triggerDistance = 168), 0f)
+        assertEquals(0f, embermineRefreshProgress(top = -140, startTop = -105, triggerDistance = 168), 0f)
+    }
+
+    @Test
+    fun `progress is zero without a trigger distance`() {
+        assertEquals(0f, embermineRefreshProgress(top = 10, startTop = -105, triggerDistance = 0), 0f)
+    }
+}
