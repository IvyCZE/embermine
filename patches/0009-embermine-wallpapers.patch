index 0000000000000000000000000000000000000000..1549bf3759236eafb0b034d81d284e01508ba651
--- /dev/null
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/wallpapers/EmbermineWallpapers.kt
@@ -0,0 +1,140 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine.wallpapers
+
+import android.graphics.Bitmap
+import android.util.Size
+import java.io.File
+import java.io.IOException
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import mozilla.components.support.base.log.logger.Logger
+import org.mozilla.fenix.settings.wallpaper.WALLPAPER_THUMBNAIL_ASPECT_RATIO
+import org.mozilla.fenix.wallpapers.Wallpaper
+
+/**
+ * The built-in Embermine collection. Its wallpapers are drawn on the device from [EmbermineWallpaperData] in the
+ * current palette and cached in the Fenix wallpaper folders. A cache is reused only while its palette and display
+ * size match.
+ *
+ * @param storageRootDirectory The top level app-local storage directory.
+ * @param getDisplaySize Returns the display size, in pixels, that full screen wallpapers are drawn at.
+ * @param getPalette Returns the palette the wallpapers should be drawn in right now.
+ */
+class EmbermineWallpapers(
+    private val storageRootDirectory: File,
+    private val getDisplaySize: () -> Size,
+    private val getPalette: () -> EmbermineWallpaperPalette,
+) {
+    private val artwork = EmbermineWallpaperData.wallpapers
+    private val mutex = Mutex()
+
+    /**
+     * Draws any wallpaper whose cache does not match the current palette and display size, then returns the
+     * collection in that palette.
+     */
+    suspend fun refresh(): List<Wallpaper> =
+        mutex.withLock {
+            withContext(Dispatchers.IO) {
+                val palette = getPalette()
+                val displaySize = getDisplaySize()
+                val fingerprint = palette.fingerprint(displaySize.width, displaySize.height)
+                artwork.forEach { art ->
+                    if (!isRendered(art.name, fingerprint)) {
+                        try {
+                            render(art, palette, displaySize, fingerprint)
+                        } catch (e: IOException) {
+                            Logger.error("Failed to render Embermine wallpaper ${art.name}", e)
+                        }
+                    }
+                }
+                wallpapers(palette)
+            }
+        }
+
+    internal fun wallpapers(palette: EmbermineWallpaperPalette): List<Wallpaper> =
+        artwork.map { art ->
+            Wallpaper(
+                name = art.name,
+                collection = collection,
+                textColor = palette.textColor,
+                cardColorLight = palette.cardColor,
+                cardColorDark = palette.cardColor,
+                thumbnailFileState = Wallpaper.ImageFileState.Downloaded,
+                assetsFileState = Wallpaper.ImageFileState.Downloaded,
+            )
+        }
+
+    private fun isRendered(name: String, fingerprint: String): Boolean {
+        val fingerprintFile = File(directory(name), FINGERPRINT_FILE)
+        return fingerprintFile.exists() &&
+            fingerprintFile.readText() == fingerprint &&
+            Wallpaper.ImageType.entries.all { File(storageRootDirectory, Wallpaper.getLocalPath(name, it)).exists() }
+    }
+
+    private fun render(
+        art: EmbermineWallpaperArt,
+        palette: EmbermineWallpaperPalette,
+        displaySize: Size,
+        fingerprint: String,
+    ) {
+        directory(art.name).mkdirs()
+        val longEdge = max(displaySize.width, displaySize.height)
+        val shortEdge = min(displaySize.width, displaySize.height)
+        val thumbnailHeight = (THUMBNAIL_WIDTH / WALLPAPER_THUMBNAIL_ASPECT_RATIO).roundToInt()
+        val sizes = mapOf(
+            Wallpaper.ImageType.Portrait to (shortEdge to longEdge),
+            Wallpaper.ImageType.Landscape to (longEdge to shortEdge),
+            Wallpaper.ImageType.Thumbnail to (THUMBNAIL_WIDTH to thumbnailHeight),
+        )
+        sizes.forEach { (type, size) ->
+            val bitmap = EmbermineWallpaperRenderer.render(art, palette, size.first, size.second)
+            writePng(bitmap, File(storageRootDirectory, Wallpaper.getLocalPath(art.name, type)))
+            bitmap.recycle()
+        }
+        File(directory(art.name), FINGERPRINT_FILE).writeText(fingerprint)
+    }
+
+    private fun writePng(bitmap: Bitmap, target: File) {
+        val temporary = File(target.parentFile, "${target.name}.tmp")
+        temporary.outputStream().use { bitmap.compress(Bitmap.CompressFormat.PNG, PNG_QUALITY, it) }
+        if (!temporary.renameTo(target)) {
+            throw IOException("Could not move ${temporary.name} into place")
+        }
+    }
+
+    private fun directory(name: String): File = File(storageRootDirectory, "wallpapers/$name")
+
+    companion object {
+        const val COLLECTION_NAME = "embermine"
+        const val DEFAULT_NAME = "bloom"
+
+        val collection =
+            Wallpaper.Collection(
+                name = COLLECTION_NAME,
+                heading = null,
+                description = null,
+                learnMoreUrl = null,
+                availableLocales = null,
+                startDate = null,
+                endDate = null,
+            )
+
+        val names: List<String>
+            get() = EmbermineWallpaperData.wallpapers.map { it.name }
+
+        /** Whether [wallpaper] belongs to the Embermine collection, which is bundled and never downloaded. */
+        fun isEmbermine(wallpaper: Wallpaper): Boolean = wallpaper.collection.name == COLLECTION_NAME
+
+        private const val FINGERPRINT_FILE = "palette.txt"
+        private const val THUMBNAIL_WIDTH = 540
+        private const val PNG_QUALITY = 100
+    }
+}
