+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine.wallpapers
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class EmbermineWallpaperRendererTest {
+
+    private val sourceWidth = 542.16f
+    private val sourceHeight = 920.73f
+
+    @Test
+    fun portraitTargetIsFilledAndCutEvenlyOnTheSides() {
+        val crop = centerCrop(1080, 2400, sourceWidth, sourceHeight)
+
+        assertCentered(crop, 1080, 2400)
+        assertEquals(0f, crop.dy, DELTA)
+        assertEquals(2400f / sourceHeight, crop.scale, DELTA)
+    }
+
+    @Test
+    fun landscapeTargetIsFilledAndCutEvenlyOnTheTopAndBottom() {
+        val crop = centerCrop(2400, 1080, sourceWidth, sourceHeight)
+
+        assertCentered(crop, 2400, 1080)
+        assertEquals(0f, crop.dx, DELTA)
+        assertEquals(2400f / sourceWidth, crop.scale, DELTA)
+    }
+
+    @Test
+    fun thumbnailTargetKeepsProportionsAndIsCentered() {
+        val crop = centerCrop(540, 491, sourceWidth, sourceHeight)
+
+        assertCentered(crop, 540, 491)
+        assertEquals(540f / sourceWidth, crop.scale, DELTA)
+    }
+
+    private fun assertCentered(crop: CenterCrop, targetWidth: Int, targetHeight: Int) {
+        val drawnWidth = sourceWidth * crop.scale
+        val drawnHeight = sourceHeight * crop.scale
+
+        assertTrue(drawnWidth >= targetWidth - DELTA)
+        assertTrue(drawnHeight >= targetHeight - DELTA)
+        assertEquals(targetWidth.toFloat(), 2 * crop.dx + drawnWidth, DELTA)
+        assertEquals(targetHeight.toFloat(), 2 * crop.dy + drawnHeight, DELTA)
+    }
+
+    private companion object {
+        const val DELTA = 0.01f
+    }
+}
