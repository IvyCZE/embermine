@@ -0,0 +1,68 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine.wallpapers
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Path
+import androidx.core.graphics.PathParser
+import androidx.core.graphics.createBitmap
+
+/**
+ * The scale and offset that place a view box on a target.
+ *
+ * @property scale The factor each view box unit is drawn at.
+ * @property dx The horizontal offset of the view box origin, in target pixels.
+ * @property dy The vertical offset of the view box origin, in target pixels.
+ */
+internal data class CenterCrop(
+    val scale: Float,
+    val dx: Float,
+    val dy: Float,
+)
+
+/**
+ * Returns the transform that fills a target with a source while keeping its proportions. The source is scaled to
+ * cover the target and centered, so equal amounts are cut from opposite edges and no bars are drawn.
+ */
+internal fun centerCrop(targetWidth: Int, targetHeight: Int, sourceWidth: Float, sourceHeight: Float): CenterCrop {
+    val scale = maxOf(targetWidth / sourceWidth, targetHeight / sourceHeight)
+    return CenterCrop(
+        scale = scale,
+        dx = (targetWidth - sourceWidth * scale) / 2f,
+        dy = (targetHeight - sourceHeight * scale) / 2f,
+    )
+}
+
+internal object EmbermineWallpaperRenderer {
+
+    /**
+     * Draws [art] in [palette] onto a new bitmap of the given size, center-cropped from the artwork's view box.
+     */
+    fun render(art: EmbermineWallpaperArt, palette: EmbermineWallpaperPalette, width: Int, height: Int): Bitmap {
+        val bitmap = createBitmap(width, height)
+        val canvas = Canvas(bitmap)
+        canvas.drawColor(palette.tones.first())
+
+        val crop = centerCrop(
+            targetWidth = width,
+            targetHeight = height,
+            sourceWidth = EmbermineWallpaperData.VIEWBOX_WIDTH,
+            sourceHeight = EmbermineWallpaperData.VIEWBOX_HEIGHT,
+        )
+        canvas.translate(crop.dx, crop.dy)
+        canvas.scale(crop.scale, crop.scale)
+
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        art.shapes.forEach { shape ->
+            val path = PathParser.createPathFromPathData(shape.path)
+            path.fillType = if (shape.evenOdd) Path.FillType.EVEN_ODD else Path.FillType.WINDING
+            paint.color = palette.tones[shape.role]
+            canvas.drawPath(path, paint)
+        }
+        return bitmap
+    }
+}
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/wallpapers/EmbermineWallpapers.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/wallpapers/EmbermineWallpapers.kt
