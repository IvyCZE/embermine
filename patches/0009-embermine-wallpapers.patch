--- /dev/null
+++ b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/wallpapers/EmbermineWallpaperPalette.kt
@@ -0,0 +1,99 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.embermine.wallpapers
+
+import android.content.Context
+import android.os.Build
+import androidx.compose.ui.graphics.toArgb
+import androidx.core.content.ContextCompat
+import mozilla.components.ui.colors.NovaColors
+
+/** Where the six tones of a wallpaper palette come from. */
+enum class EmbermineWallpaperPaletteSource {
+    Ember,
+    System,
+    Nova,
+}
+
+/**
+ * Six ARGB tones for the wallpaper roles, from the darkest background (role 0) to the lightest (role 5).
+ *
+ * @property tones The tone of each role, in role order.
+ */
+class EmbermineWallpaperPalette(
+    val tones: List<Int>,
+) {
+    init {
+        require(tones.size == ROLE_COUNT) { "A wallpaper palette needs $ROLE_COUNT tones" }
+    }
+
+    /** Color for text drawn on a wallpaper: the lightest tone. */
+    val textColor: Long
+        get() = tones.last().toLong() and OPAQUE_MASK
+
+    /** Color for cards laid over a wallpaper: a translucent dark tone, so the wallpaper shows through. */
+    val cardColor: Long
+        get() = (CARD_ALPHA shl ALPHA_SHIFT) or (tones[CARD_ROLE].toLong() and RGB_MASK)
+
+    /** Identifies a rendering of this palette at the given pixel size. */
+    fun fingerprint(width: Int, height: Int): String =
+        "$RENDER_VERSION:${tones.joinToString(",") { Integer.toHexString(it) }}@${width}x$height"
+
+    companion object {
+        private const val ROLE_COUNT = 6
+        private const val CARD_ROLE = 1
+        private const val CARD_ALPHA = 0xC0L
+        private const val ALPHA_SHIFT = 24
+        private const val RGB_MASK = 0xFFFFFFL
+        private const val OPAQUE_MASK = 0xFFFFFFFFL
+        private const val RENDER_VERSION = "v1"
+
+        /** Picks the palette source: Ember below Android 12, the system accent when the switch is on, else Nova. */
+        fun source(sdkInt: Int, switchOn: Boolean): EmbermineWallpaperPaletteSource =
+            when {
+                sdkInt < Build.VERSION_CODES.S -> EmbermineWallpaperPaletteSource.Ember
+                switchOn -> EmbermineWallpaperPaletteSource.System
+                else -> EmbermineWallpaperPaletteSource.Nova
+            }
+
+        /** The palette that applies to the device right now. */
+        fun current(context: Context, switchOn: Boolean): EmbermineWallpaperPalette =
+            when (source(Build.VERSION.SDK_INT, switchOn)) {
+                EmbermineWallpaperPaletteSource.Ember -> ember()
+                EmbermineWallpaperPaletteSource.System -> system(context)
+                EmbermineWallpaperPaletteSource.Nova -> nova()
+            }
+
+        fun ember(): EmbermineWallpaperPalette =
+            argb(0xFF120A08, 0xFF3A1410, 0xFF7A2414, 0xFFC2410C, 0xFFF97316, 0xFFFDBA74)
+
+        fun nova(): EmbermineWallpaperPalette =
+            EmbermineWallpaperPalette(
+                listOf(
+                    NovaColors.Violet90,
+                    NovaColors.Violet70,
+                    NovaColors.Violet60,
+                    NovaColors.Violet50,
+                    NovaColors.Violet30,
+                    NovaColors.Violet10,
+                ).map { it.toArgb() },
+            )
+
+        private fun system(context: Context): EmbermineWallpaperPalette =
+            EmbermineWallpaperPalette(
+                listOf(
+                    android.R.color.system_accent1_900,
+                    android.R.color.system_accent1_800,
+                    android.R.color.system_accent1_600,
+                    android.R.color.system_accent1_500,
+                    android.R.color.system_accent1_300,
+                    android.R.color.system_accent1_100,
+                ).map { ContextCompat.getColor(context, it) },
+            )
+
+        private fun argb(vararg colors: Long): EmbermineWallpaperPalette =
+            EmbermineWallpaperPalette(colors.map { it.toInt() })
+    }
+}
diff --git a/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/wallpapers/EmbermineWallpaperRenderer.kt b/mobile/android/fenix/app/src/main/java/org/mozilla/fenix/embermine/wallpapers/EmbermineWallpaperRenderer.kt
