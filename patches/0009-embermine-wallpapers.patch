+
+package org.mozilla.fenix.embermine.wallpapers
+
+import android.util.Size
+import java.io.File
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.mozilla.fenix.wallpapers.Wallpaper
+
+class EmbermineWallpapersTest {
+
+    private val palette = EmbermineWallpaperPalette.ember()
+    private val wallpapers = EmbermineWallpapers(File("unused"), { Size(1080, 2400) }, { palette })
+
+    @Test
+    fun collectionListsBundledWallpapersInOrder() {
+        assertEquals(listOf("bloom", "grow", "pattern", "rise", "triangle"), EmbermineWallpapers.names)
+        assertTrue(EmbermineWallpapers.DEFAULT_NAME in EmbermineWallpapers.names)
+    }
+
+    @Test
+    fun wallpapersUseThePaletteColorsAndCollection() {
+        val list = wallpapers.wallpapers(palette)
+
+        assertEquals(EmbermineWallpapers.names, list.map { it.name })
+        list.forEach { wallpaper ->
+            assertEquals(EmbermineWallpapers.collection, wallpaper.collection)
+            assertEquals(palette.textColor, wallpaper.textColor)
+            assertEquals(palette.cardColor, wallpaper.cardColorLight)
+            assertEquals(palette.cardColor, wallpaper.cardColorDark)
+            assertEquals(Wallpaper.ImageFileState.Downloaded, wallpaper.thumbnailFileState)
+            assertEquals(Wallpaper.ImageFileState.Downloaded, wallpaper.assetsFileState)
+        }
+    }
+
+    @Test
+    fun onlyBundledWallpapersAreEmbermine() {
+        wallpapers.wallpapers(palette).forEach { assertTrue(EmbermineWallpapers.isEmbermine(it)) }
+        assertFalse(EmbermineWallpapers.isEmbermine(Wallpaper.Default))
+        assertFalse(EmbermineWallpapers.isEmbermine(Wallpaper.EdgeToEdge))
+    }
+}
