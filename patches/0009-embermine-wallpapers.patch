+package org.mozilla.fenix.embermine.wallpapers
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Test
+
+class EmbermineWallpaperPaletteTest {
+
+    @Test
+    fun paletteSourceIsEmberBelowAndroid12() {
+        assertEquals(EmbermineWallpaperPaletteSource.Ember, EmbermineWallpaperPalette.source(30, switchOn = true))
+        assertEquals(EmbermineWallpaperPaletteSource.Ember, EmbermineWallpaperPalette.source(30, switchOn = false))
+        assertEquals(EmbermineWallpaperPaletteSource.Ember, EmbermineWallpaperPalette.source(26, switchOn = true))
+    }
+
+    @Test
+    fun paletteSourceFollowsSwitchFromAndroid12() {
+        assertEquals(EmbermineWallpaperPaletteSource.System, EmbermineWallpaperPalette.source(31, switchOn = true))
+        assertEquals(EmbermineWallpaperPaletteSource.System, EmbermineWallpaperPalette.source(34, switchOn = true))
+        assertEquals(EmbermineWallpaperPaletteSource.Nova, EmbermineWallpaperPalette.source(31, switchOn = false))
+        assertEquals(EmbermineWallpaperPaletteSource.Nova, EmbermineWallpaperPalette.source(34, switchOn = false))
+    }
+
+    @Test
+    fun emberPaletteUsesCharcoalToAmberRoles() {
+        assertEquals(
+            listOf(0xFF120A08, 0xFF3A1410, 0xFF7A2414, 0xFFC2410C, 0xFFF97316, 0xFFFDBA74).map { it.toInt() },
+            EmbermineWallpaperPalette.ember().tones,
+        )
+    }
+
+    @Test
+    fun textIsTheLightestTone() {
+        assertEquals(0xFFFDBA74L, EmbermineWallpaperPalette.ember().textColor)
+    }
+
+    @Test
+    fun cardIsTranslucentDarkTone() {
+        assertEquals(0xC03A1410L, EmbermineWallpaperPalette.ember().cardColor)
+    }
+
+    @Test
+    fun fingerprintChangesWithTonesAndSize() {
+        val ember = EmbermineWallpaperPalette.ember()
+        val shifted = EmbermineWallpaperPalette(
+            ember.tones.mapIndexed { index, tone -> if (index == 0) tone + 1 else tone },
+        )
+
+        assertEquals(ember.fingerprint(1080, 2400), EmbermineWallpaperPalette.ember().fingerprint(1080, 2400))
+        assertNotEquals(ember.fingerprint(1080, 2400), shifted.fingerprint(1080, 2400))
+        assertNotEquals(ember.fingerprint(1080, 2400), ember.fingerprint(2400, 1080))
+    }
+
+    @Test(expected = IllegalArgumentException::class)
+    fun paletteNeedsSixTones() {
+        EmbermineWallpaperPalette(listOf(0xFF000000.toInt(), 0xFFFFFFFF.toInt()))
+    }
+}
